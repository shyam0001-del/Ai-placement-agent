# ==========================================
# AI Placement Agent - Environment Variables
# ==========================================

# Server Port
PORT=5000

# Node Environment (development / production)
NODE_ENV=development

# Allowed CORS Origin for Frontend
CORS_ORIGIN=http://localhost:5173

# OpenAI-Compatible API Configuration
# Works with OpenAI, Groq, Ollama, OpenRouter, DeepSeek, etc.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional base URL (leave blank for default official OpenAI API)
# OPENAI_BASE_URL=https://api.openai.com/v1

# MongoDB Connection String (Required in Phase 2+)
MONGODB_URI=mongodb://localhost:27017/placement_agent
