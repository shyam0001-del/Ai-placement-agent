# ==========================================
# AI Placement Agent - Environment Variables
# ==========================================

# Server Port
PORT=5000

# Node Environment (development / production)
NODE_ENV=development

# Allowed CORS Origin for Frontend
CORS_ORIGIN=http://localhost:5173

# OpenAI-Compatible API Configuration
# Works with OpenAI, Groq, Ollama, OpenRouter, DeepSeek, etc.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# MongoDB Connection String (Required for Phase 2 profile persistence)
MONGODB_URI=mongodb://localhost:27017/placement_agent
